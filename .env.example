# Copy to .env.local and fill in. Every block is optional:
# leaving a block empty disables that feature and the app keeps working locally.

# ---- Supabase (login / cloud sync / photo storage) ----
# Local: values printed by `npx supabase start` (or `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to store push subscriptions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Show the "Sign in with Google" button (enable the Google provider in Supabase first)
NEXT_PUBLIC_AUTH_GOOGLE=false

# ---- Web Push (notifications while the app is closed) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects GET /api/push/cron (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---- AI monthly report (OpenAI-compatible Chat Completions API) ----
# Empty = built-in template report
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
